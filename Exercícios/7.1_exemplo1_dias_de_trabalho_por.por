programa
{
	
	funcao inicio()
	{
		real segunda, terca, quarta, quinta, sexta, dias_somados

		escreva("Digite o pagamento da segunda\n")
		leia(segunda)

		escreva("Digite o pagamento de terça\n")
		leia(terca)

		escreva("Digite o pagamento de quarta\n")
		leia(quarta)

		escreva("Digite o pagamento de quinta\n")
		leia(quinta)

		escreva("Digite o pagamento de sexta\n")
		leia(sexta)

		dias_somados = segunda + terca + quarta + quinta + sexta
		escreva("O total ganho por cada dia trabalhada na semana é:\nR$ ", dias_somados)
		
	}
}
