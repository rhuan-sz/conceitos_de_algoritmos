programa
{
	
	funcao inicio()
	{
		inteiro numero, sucessor, antecessor

		escreva("Digite um número\n")
		leia(numero)
		escreva("O número digitado é:\n", numero)

		sucessor = numero + 1
		escreva("\nO sucessor do número inserido é:\n", sucessor)

		antecessor = numero - 1
		escreva("\nO antecessor do número inserido é:\n", antecessor)
		

		
	}
}
